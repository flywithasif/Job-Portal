# ============================================
# SERVER
# ============================================

PORT=5000

# development | production
NODE_ENV=development


# ============================================
# DATABASE
# ============================================

# Local MongoDB example:
MONGO_URI=mongodb://127.0.0.1:27017/job_portal

# Production example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>


# ============================================
# FRONTEND / CORS
# ============================================

# Multiple frontend URLs can be separated by commas.
CLIENT_URL=http://localhost:5173


# ============================================
# JWT AUTHENTICATION
# ============================================

# IMPORTANT:
# Generate a long random secret for the real .env file.
# NEVER use this example value in production.
JWT_SECRET=replace_with_a_long_random_secret

# JWT lifetime
JWT_EXPIRES_IN=1d